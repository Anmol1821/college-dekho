# Local development environment for the Govt Drish backend.
# This file is git-ignored (see .gitignore). Never commit real keys.

# Makes DEBUG=True, permissive CORS and plain static storage locally.
# Delete this line (or set DEBUG=False) and set real vars for production.
DEBUG=True

# Google Gemini API key — SAME bot API as the website chatbot:
# model gemini-3.1-flash-lite with Google Search grounding.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# How long an AI answer is reused for the same question (seconds), so page
# reloads and other visitors do not spend another Gemini credit. Default 1800.
# AI_SEARCH_CACHE_SECONDS=1800

# Only used when DEBUG=False (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production-only settings:
# DJANGO_SECRET_KEY=  (python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DATABASE_URL=postgres://...
